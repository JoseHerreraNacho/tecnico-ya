
import {
  Component,
  ElementRef,
  EventEmitter,
  Input,
  OnDestroy,
  Output,
  ViewChild,
  AfterViewInit
} from '@angular/core';

import { CommonModule } from '@angular/common';
import * as L from 'leaflet';

@Component({
  selector: 'app-location-map',
  standalone: true,
  imports: [CommonModule],

  template: `
    <div class="location-container">

      <h3>02 · Ubicación del servicio</h3>

      <p>
        Busca tu dirección o selecciona el punto
        exacto directamente en el mapa.
      </p>

      <button
        type="button"
        class="map-btn"
        (click)="searchAddress()"
        [disabled]="searching"
      >
        {{ searching ? 'Buscando...' : 'Buscar dirección' }}
      </button>

      <div #mapElement class="map"></div>

      <p *ngIf="selected">
        Coordenadas:
        {{ selected.lat.toFixed(6) }},
        {{ selected.lng.toFixed(6) }}
      </p>

      <p *ngIf="error" class="error">
        {{ error }}
      </p>

      <button
        type="button"
        class="map-btn confirm"
        [disabled]="!selected"
        (click)="confirmLocation()"
      >
        {{ confirmed
          ? '✓ Ubicación confirmada'
          : 'Confirmar ubicación' }}
      </button>

      <small>
        © OpenStreetMap contributors
      </small>

    </div>
  `,

  styles: [`
    .location-container {
      background: #f8fbff;
      border: 1px solid #dbe5f2;
      border-radius: 15px;
      padding: 20px;
    }

    h3 {
      color: #183e80;
      margin-bottom: 10px;
    }

    p {
      color: #52627a;
      font-size: 14px;
    }

    .map {
      height: 350px;
      width: 100%;
      margin: 15px 0;
      border-radius: 12px;
      overflow: hidden;
      z-index: 0;
    }

    .map-btn {
      background: #2563eb;
      color: white;
      border: none;
      padding: 12px 18px;
      border-radius: 10px;
      font-weight: 600;
      cursor: pointer;
    }

    .map-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .confirm {
      width: 100%;
      background: #15803d;
      margin-bottom: 12px;
    }

    .error {
      color: #dc2626;
    }

    small {
      color: #64748b;
    }
  `]
})

export class LocationMapComponent
  implements AfterViewInit, OnDestroy {

  @Input() address = '';
  @Input() comuna = '';

  @Output() locationSelected =
    new EventEmitter<{
      latitude: number;
      longitude: number;
      location_confirmed: boolean;
    }>();

  @ViewChild('mapElement')
  mapElement!: ElementRef<HTMLDivElement>;

  private map?: L.Map;
  private marker?: L.CircleMarker;

  selected: L.LatLng | null = null;
  confirmed = false;
  searching = false;
  error = '';

  ngAfterViewInit(): void {

    this.map = L.map(
      this.mapElement.nativeElement
    ).setView(
      [-33.4489, -70.6693],
      11
    );

    L.tileLayer(
      'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
      {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
      }
    ).addTo(this.map);

    this.map.on('click', event => {
      this.setLocation(event.latlng);
    });

    setTimeout(() => {
      this.map?.invalidateSize();
    }, 100);
  }

  private setLocation(position: L.LatLng): void {

    this.selected = position;
    this.confirmed = false;

    if (this.marker) {
      this.marker.setLatLng(position);
    } else {
      this.marker = L.circleMarker(position, {
        radius: 10,
        color: '#ffffff',
        weight: 3,
        fillColor: '#2563eb',
        fillOpacity: 1
      }).addTo(this.map!);
    }

    this.locationSelected.emit({
      latitude: position.lat,
      longitude: position.lng,
      location_confirmed: false
    });
  }

  async searchAddress(): Promise<void> {

    if (!this.address.trim() || !this.comuna.trim()) {
      this.error = 'Ingresa dirección y comuna primero.';
      return;
    }

    this.searching = true;
    this.error = '';

    try {

      const params = new URLSearchParams({
        q: `${this.address}, ${this.comuna}, Chile`,
        format: 'json',
        limit: '1',
        countrycodes: 'cl'
      });

      const response = await fetch(
        'https://nominatim.openstreetmap.org/search?' +
        params.toString(),
        {
          headers: {
            Accept: 'application/json'
          }
        }
      );

      if (!response.ok) {
        throw new Error('Error buscando dirección');
      }

      const results = await response.json();

      if (!results.length) {
        this.error =
          'No se encontró la dirección. Selecciónala manualmente.';
        return;
      }

      const position = L.latLng(
        Number(results[0].lat),
        Number(results[0].lon)
      );

      this.map?.setView(position, 17);
      this.setLocation(position);

    } catch {
      this.error =
        'No fue posible buscar. Selecciona el punto en el mapa.';
    } finally {
      this.searching = false;
    }
  }

  confirmLocation(): void {

    if (!this.selected) return;

    this.confirmed = true;

    this.locationSelected.emit({
      latitude: this.selected.lat,
      longitude: this.selected.lng,
      location_confirmed: true
    });
  }

  ngOnDestroy(): void {
    this.map?.remove();
  }
}
